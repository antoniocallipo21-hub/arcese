---
import { getEntry } from 'astro:content';
interface Props { animate?: boolean; tone?: 'dark' | 'light' }
const { animate = false, tone = 'dark' } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);

type Item = { label: string; href: string };
const nav: Item[] = [
  { label: 'About', href: '/about/' },
  { label: 'Stallions', href: '/stallions/' },
  { label: 'Mares', href: '/mares/' },
  { label: 'Lexi', href: '/lexi/' },
  { label: 'Records', href: '/records/' },
  { label: 'News', href: '/news/' },
  { label: 'Media', href: '/media/' },
  { label: 'Contact', href: '/contact/' },
];
const mid = 4; // voci a sinistra del logo
---
<header class:list={['header', { ready: !animate, past: tone === 'light' && !animate }]} data-animate={animate} style={animate ? '--p:0' : '--p:1'}>
  <div class="container header__bar">
    <button class="burger" aria-expanded="false" aria-controls="nav" aria-label="Menu"><span></span></button>
    <nav id="nav" class="nav" aria-label="Main" style={site.heroImage ? `--menu-bg:url(${site.heroImage})` : undefined}>
      <ul class="nav__l">
        {nav.slice(0, mid).map((item) => <li class:list={[{ active: isActive(item.href) }]}><a href={item.href}>{item.label}</a></li>)}
      </ul>
      <span class="spacer" aria-hidden="true"></span>
      <ul class="nav__r">
        {nav.slice(mid).map((item) => <li class:list={[{ active: isActive(item.href) }]}><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

{site.logo && (
  <a class:list={['fly', { static: !animate, past: tone === 'light' && !animate }]} href="/" aria-label={`${site.siteName} – home`}>
    <img class="fly__img" src={site.logo} alt={site.siteName} />
  </a>
)}

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const nav = document.getElementById('nav');
  const header = document.querySelector<HTMLElement>('.header');
  const setMenu = (open: boolean) => {
    btn?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('open', open);
    document.documentElement.classList.toggle('menu-open', open);
  };
  btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  addEventListener('resize', () => { if (innerWidth > 1180) setMenu(false); });

  const fly = document.querySelector<HTMLElement>('.fly');
  if (header && fly) {
    const animate = header.dataset.animate === 'true';
    const img = fly.querySelector<HTMLElement>('.fly__img')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
    let ticking = false;
    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      if (animate) {
        // Home: il logo ruota e si porta al centro del menu mentre si scorre
        const p = ease(Math.min(1, Math.max(0, scrollY / (vh * 0.85))));
        const startW = Math.min(innerWidth * 0.72, 760);
        const endW = innerWidth < 640 ? 120 : 170;
        const W = lerp(startW, endW, p);
        const KEEP = 0.47; // il simbolo occupa i primi ~47% del file, il resto è la scritta
        const cut = (1 - KEEP) * Math.min(1, p / 0.75);
        fly.style.width = `${W}px`;
        fly.style.top = `${lerp(vh / 2, 36, p)}px`;
        fly.style.transformOrigin = `${(1 - cut) * 50}% 50%`;
        fly.style.transform = `translate(-50%, -50%) translateX(${(cut / 2) * W}px) perspective(900px) rotateY(${reduced ? 0 : p * 360}deg)`;
        img.style.clipPath = `inset(0 ${cut * 100}% 0 0)`;
        header.style.setProperty('--p', String(p));
        header.classList.toggle('ready', p > 0.6);
      }
      // Colori in base a cosa c'è sotto l'header: [data-tone="hero"] = foto a schermo intero (trasparente), altrimenti barra bianca
      const hit = document.elementsFromPoint(innerWidth / 2, 36).find((e) => e.closest('[data-tone]'));
      const light = hit?.closest<HTMLElement>('[data-tone]')?.dataset.tone !== 'hero'; // fuori dalla hero: barra bianca
      header.classList.toggle('past', light);
      fly.classList.toggle('past', light);
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>
<style>
  .header { position: fixed; left: 0; right: 0; top: 0; z-index: 50; background: transparent; border-bottom: 1px solid transparent; transition: background .3s, border-color .3s, backdrop-filter .3s; }
  /* Fuori dalla hero: bianco leggero, semitrasparente e sfocato */
  .header.past { background: rgba(255,255,255,.82); border-bottom-color: rgba(0,0,0,.06); -webkit-backdrop-filter: saturate(1.4) blur(14px); backdrop-filter: saturate(1.4) blur(14px); }
  .header__bar { display: flex; align-items: center; justify-content: center; min-height: 72px; gap: 16px; }
  .nav ul { list-style: none; margin: 0; padding: 0; }
  .nav { display: grid; grid-template-columns: 1fr 130px 1fr; align-items: center; width: 100%; }
  .nav ul { display: flex; align-items: center; }
  .nav__l { justify-content: flex-end; } .nav__r { justify-content: flex-start; }
  .nav li { position: relative; }
  .nav a { display: block; padding: 10px 11px; text-decoration: none; font-family: var(--font-display); font-weight: 600; font-size: .98rem; text-transform: uppercase;
    letter-spacing: .08em; color: #fff; text-shadow: 0 1px 14px rgba(0,0,0,.55); }
  .nav li.active > a, .nav a:hover { color: #ff4a62; }
  .header.past .nav ul > li > a { color: var(--black); text-shadow: none; }
  .header.past .nav ul > li.active > a, .header.past .nav ul > li > a:hover { color: var(--red); }
  .nav, .burger { opacity: var(--p); visibility: hidden; }
  .header.ready .nav, .header.ready .burger { visibility: visible; }
  .burger { display: none; width: 44px; height: 44px; background: none; border: 0; cursor: pointer; position: relative; }
  .burger span, .burger span::before, .burger span::after { position: absolute; left: 10px; width: 24px; height: 2px; background: #fff; content: ''; }
  .burger span { top: 21px; } .burger span::before { top: -7px; left: 0; } .burger span::after { top: 7px; left: 0; }
  .header.past .burger span, .header.past .burger span::before, .header.past .burger span::after { background: var(--black); }

  .fly { position: fixed; left: 50%; top: 50vh; z-index: 60; display: block; width: min(72vw, 760px); transform: translate(-50%, -50%); will-change: transform, width, top; pointer-events: none; }
  .fly__img { pointer-events: auto; transition: filter .35s; display: block; width: 100%; height: auto; filter: brightness(0) invert(1) drop-shadow(0 4px 24px rgba(0,0,0,.35)); }
  .fly.past .fly__img { filter: none; }
  /* Pagine interne: logo già nella posizione finale (solo il simbolo) */
  .fly.static { top: 36px; width: 170px; transform: translate(calc(-50% + 45px), -50%); }
  .fly.static .fly__img { clip-path: inset(0 53% 0 0); }
  @media (max-width: 639px) { .fly.static { width: 120px; transform: translate(calc(-50% + 32px), -50%); } }

  @media (max-width: 1180px) {
    .burger { display: block; position: relative; z-index: 3; }
    .header__bar { justify-content: flex-end; }
    /* Menu a schermo intero: foto in trasparenza, voci centrate */
    .header.header .nav { display: flex; flex-direction: column; align-items: center; justify-content: center; position: fixed; inset: 0; z-index: 2; width: auto; box-sizing: border-box;
      padding: 96px var(--gutter) 48px; background: #0b0b0b; overflow-y: auto; opacity: 0; visibility: hidden; transition: opacity .35s ease, visibility 0s linear .35s; }
    .header.header .nav.open { opacity: 1; visibility: visible; transition: opacity .35s ease; }
    .nav::before { content: ''; position: fixed; inset: 0; z-index: -2; background: var(--menu-bg, none) center / cover no-repeat; opacity: .32; }
    .nav::after { content: ''; position: fixed; inset: 0; z-index: -1; background: linear-gradient(to bottom, rgba(11,11,11,.55), rgba(11,11,11,.15) 40%, rgba(11,11,11,.7)); }
    .nav ul { flex-direction: column; align-items: center; justify-content: center; width: 100%; }
    .nav li { width: 100%; text-align: center; opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
    .nav.open li { opacity: 1; transform: none; }
    .nav.open li:nth-child(1) { transition-delay: .08s; } .nav.open li:nth-child(2) { transition-delay: .13s; }
    .nav.open li:nth-child(3) { transition-delay: .18s; } .nav.open li:nth-child(4) { transition-delay: .23s; }
    .nav.open .nav__r li:nth-child(1) { transition-delay: .28s; } .nav.open .nav__r li:nth-child(2) { transition-delay: .33s; } .nav.open .nav__r li:nth-child(3) { transition-delay: .38s; }
    .header .nav ul > li > a { display: inline-block; color: #fff !important; text-shadow: 0 2px 20px rgba(0,0,0,.5); font-size: clamp(1.9rem, 8.2vw, 2.8rem); letter-spacing: .12em; padding: clamp(8px, 1.8vh, 14px) 12px; }
    .header .nav ul > li.active > a { color: #ff4a62 !important; }
    .spacer { display: none; }
    /* Con il menu aperto: barra trasparente (il blur creerebbe un contenitore per il fixed), logo e icona bianchi, niente scroll sotto */
    :global(html.menu-open) { overflow: hidden; }
    :global(html.menu-open) .header { background: transparent; border-bottom-color: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; transition: none; }
    :global(html.menu-open) .fly { z-index: 70; }
    :global(html.menu-open) .fly .fly__img { filter: brightness(0) invert(1) !important; }
    :global(html.menu-open) .header .burger span::before, :global(html.menu-open) .header .burger span::after { background: #fff !important; }
    .burger span, .burger span::before, .burger span::after { transition: transform .3s ease, top .3s ease, background .2s; }
    .burger[aria-expanded="true"] span { background: transparent !important; }
    .burger[aria-expanded="true"] span::before { top: 0; transform: rotate(45deg); }
    .burger[aria-expanded="true"] span::after { top: 0; transform: rotate(-45deg); }
  }
</style>
