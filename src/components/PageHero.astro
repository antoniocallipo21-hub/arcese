---
interface Props { eyebrow?: string; title: string; intro?: string; image?: string; imagePosition?: string; compact?: boolean; imageMobile?: string; imageMobilePosition?: string; logoMobile?: string; logoOverlay?: string; logoSide?: 'left' | 'right'; logoTop?: string; logoAlt?: string }
const { eyebrow, title, intro: rawIntro, image, imagePosition, compact = false, imageMobile, imageMobilePosition, logoMobile, logoOverlay, logoSide = 'left', logoTop, logoAlt = '' } = Astro.props;
const intro = rawIntro?.trim().replace(/[.。]+$/, '');
---
{compact ? (
  <section class="phero">
    <div class="container">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <hr class="rule" />
      {intro && <p class="intro">{intro}</p>}
    </div>
  </section>
) : (
  <section class="fhero" data-tone="hero">
    {image && (
      <picture>
        {imageMobile && <source media="(max-width: 700px)" srcset={imageMobile} />}
        <img src={image} alt="" fetchpriority="high" style={[imagePosition ? `object-position:${imagePosition};--pd:${imagePosition}` : '', imageMobilePosition ? `--pm:${imageMobilePosition}` : ''].filter(Boolean).join(';') || undefined} />
      </picture>
    )}
    <div class="container fhero__in">
      <div class="fhero__txt">
        <h1 class:list={{ long: title.length > 26 }}>{title}</h1>
        {Astro.slots.has('default') && <div class="fhero__cta"><slot /></div>}
      </div>
    </div>
 {logoOverlay && <div class:list={['container fhero__ov', { right: logoSide === 'right' }]} style={logoTop ? `--ovtop:${logoTop}` : undefined}><img src={logoOverlay} alt={logoAlt} /></div>}
 {logoMobile && <img class="fhero__logo" src={logoMobile} alt={logoAlt} />}
    <button class="cue" type="button" aria-label="Scroll down"><span></span></button>
  </section>
)}
<script>
  document.querySelector<HTMLButtonElement>('.cue')?.addEventListener('click', () => {
    const h = document.querySelector<HTMLElement>('.fhero')?.offsetHeight ?? innerHeight;
    scrollTo({ top: h, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
</script>
<style>
  /* Compatta (pagine di testo) */
  .phero { background: var(--paper); padding: calc(72px + clamp(32px, 6vw, 72px)) 0 clamp(28px, 5vw, 56px); border-bottom: 1px solid var(--line); }
  .phero h1 { font-size: clamp(2.4rem, 6vw, 4.5rem); margin-bottom: .3em; }
  .intro { font-size: 1.2rem; max-width: 60ch; margin: 0; color: var(--muted); }

  /* Intera: a tutto schermo */
  .fhero { position: relative; height: 100vh; height: 100lvh; min-height: 520px; display: grid; align-items: end; background: #111; overflow: hidden; }
  .fhero picture { display: contents; }
  .fhero__ov { position: absolute; z-index: 2; left: 0; right: 0; top: var(--ovtop, clamp(96px, 14vh, 150px)); pointer-events: none; }
  .fhero__ov.right img { margin-left: auto; }
  .fhero__ov img { display: block; width: clamp(150px, 17vw, 270px); height: auto; filter: drop-shadow(0 4px 16px rgba(0,0,0,.35)); }
  @media (max-width: 700px) { .fhero__ov { top: 92px; --ovtop: 92px; } .fhero__ov img { margin-left: auto; width: 140px; } }
  .fhero__logo { display: none; }
  @media (max-width: 700px) { .fhero__logo { display: block; position: absolute; z-index: 2; left: 16px; top: calc(100lvh - 250px); width: min(58vw, 240px); height: auto; filter: drop-shadow(0 4px 14px rgba(0,0,0,.45)); } }
  @media (max-width: 700px) { .fhero picture img { object-position: var(--pm, var(--pd, center)) !important; } }
  .fhero picture img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .fhero::before { content: ''; position: absolute; inset: 0; z-index: 1;
    background: linear-gradient(to bottom, rgba(0,0,0,.5), transparent 24%), linear-gradient(to top, rgba(0,0,0,.78), rgba(0,0,0,.05) 58%); }
  /* Safari su iPhone: la barra del browser galleggia sopra la pagina e le unità vh non la contano, quindi aggiungo il margine mancante */
  @media (max-width: 700px) { .fhero { height: calc(100lvh + 64px); } .fhero__in { padding-bottom: clamp(96px, 16vh, 150px) !important; } .cue { bottom: 56px; } }
  .fhero__in { position: relative; z-index: 2; width: 100%; padding-bottom: clamp(72px, 12vh, 120px); }
  .fhero__txt { min-width: 0; }
  .fhero h1 { color: #fff; margin: 0; font-size: clamp(2.6rem, 10vw, 8rem); overflow-wrap: anywhere; }
  .fhero h1.long { font-size: clamp(2.2rem, 5.2vw, 4.4rem); max-width: 22ch; line-height: 1.02; }
  .fhero .eyebrow { color: #fff; opacity: .85; }
  .fhero__intro { color: #fff; opacity: .9; font-size: 1.2rem; max-width: 52ch; margin: .8rem 0 0; }
  .fhero__cta { margin-top: 1.4rem; display: flex; flex-wrap: wrap; gap: 12px; }
  .fhero__cta :global(a) { display: inline-flex; align-items: center; gap: 10px; padding: 13px 28px; border-radius: 999px; background: #fff; color: var(--red); font-family: var(--font-display); text-transform: uppercase; letter-spacing: .14em; font-weight: 700; font-size: .95rem; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .fhero__cta :global(a:hover) { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(0,0,0,.35); }
  .cue { position: absolute; z-index: 2; left: 50%; bottom: 26px; width: 28px; height: 46px; transform: translateX(-50%); border: 2px solid rgba(255,255,255,.8); border-radius: 16px; background: none; padding: 0; cursor: pointer; }
  .cue span { position: absolute; left: 50%; top: 8px; width: 4px; height: 8px; margin-left: -2px; background: #fff; border-radius: 2px; animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { opacity: 0; transform: translateY(0); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(16px); } }
  @media (prefers-reduced-motion: reduce) { .cue span { animation: none; opacity: 1; } }
</style>
