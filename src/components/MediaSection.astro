---
interface Props { name: string; video?: string; gallery?: string[]; poster?: string }
const { name, video, gallery = [], poster } = Astro.props;
---
  {(video || gallery.length > 0) && (
    <section class="section section--paper">
      <div class="container">
        {video && (
          <div class="vid">
            <p class="eyebrow reveal">In action</p>
            <h2 class="reveal">Video</h2>
            <hr class="rule" />
            <button class="play reveal" type="button" data-video={video} aria-label={`Play video of ${name}`} style={(poster ?? gallery[0]) ? `background-image:url(${poster ?? gallery[0]})` : undefined}>
              <span class="tri" aria-hidden="true"></span>
            </button>
          </div>
        )}
        {gallery.length > 0 && (
          <div class="gal">
            <p class="eyebrow reveal">Photo gallery</p>
            <h2 class="reveal">{name}</h2>
            <hr class="rule" />
            <div class="gal__wrap">
            <button class="gal__nav gal__nav--prev" type="button" aria-label="Previous photos" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
            <button class="gal__nav gal__nav--next" type="button" aria-label="Next photos"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
            <ul class="gal__grid">
              {gallery.map((src, i) => (
                <li class="reveal" style={`--d:${(i % 3) * 90}ms`}>
                  <button type="button" data-src={src} aria-label={`Open photo ${i + 1}`}><img src={src} alt={`${name}, photo ${i + 1}`} loading="lazy" /></button>
                </li>
              ))}
            </ul>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <dialog class="lb" id="lb" aria-label="Photo viewer">
    <button class="lb__x" type="button" aria-label="Close">×</button>
    <button class="lb__nav lb__nav--prev" type="button" aria-label="Previous photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
    <button class="lb__nav lb__nav--next" type="button" aria-label="Next photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
    <img alt="" />
    <p class="lb__n" aria-live="polite"></p>
  </dialog>
<script>
  // Video: l'iframe di YouTube (nocookie) si carica solo al click
  document.querySelectorAll<HTMLButtonElement>('.play').forEach((b) => b.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.video}?autoplay=1&rel=0`;
    f.title = 'Video'; f.allow = 'autoplay; encrypted-media; picture-in-picture'; f.allowFullscreen = true; f.className = 'frame';
    b.replaceWith(f);
  }));

  // Galleria: visualizzatore a schermo intero
  const lb = document.querySelector<HTMLDialogElement>('#lb');
  const lbImg = lb?.querySelector('img');
  const lbN = lb?.querySelector('.lb__n');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.gal__grid button')];
  let cur = 0;
  const show = (i: number) => {
    if (!lbImg || !thumbs.length) return;
    cur = (i + thumbs.length) % thumbs.length;
    lbImg.src = thumbs[cur].dataset.src!;
    if (lbN) lbN.textContent = `${cur + 1} / ${thumbs.length}`;
    // tiene la fila sotto allineata alla foto aperta
    thumbs[cur].closest('li')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  };
  thumbs.forEach((b, i) => b.addEventListener('click', () => { if (!lb) return; show(i); lb.showModal(); }));
  lb?.querySelector('.lb__nav--prev')?.addEventListener('click', (e) => { e.stopPropagation(); show(cur - 1); });
  lb?.querySelector('.lb__nav--next')?.addEventListener('click', (e) => { e.stopPropagation(); show(cur + 1); });
  lb?.addEventListener('click', () => lb.close());
  lb?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(cur - 1);
    if (e.key === 'ArrowRight') show(cur + 1);
  });
  // Swipe su telefono
  let x0 = 0;
  lb?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) { show(cur + (dx < 0 ? 1 : -1)); suppress = true; setTimeout(() => (suppress = false), 300); }
  });
  let suppress = false;
  lb?.addEventListener('click', (e) => { if (suppress) e.stopImmediatePropagation(); }, true);

  // Galleria: frecce per scorrere
  const strip = document.querySelector<HTMLElement>('.gal__grid');
  const prev = document.querySelector<HTMLButtonElement>('.gal__nav--prev');
  const next = document.querySelector<HTMLButtonElement>('.gal__nav--next');
  if (strip && prev && next) {
    const sync = () => {
      prev.hidden = strip.scrollLeft < 8;
      next.hidden = strip.scrollLeft + strip.clientWidth >= strip.scrollWidth - 8;
    };
    const go = (dir: number) => strip.scrollBy({ left: dir * strip.clientWidth * 0.8, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    strip.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    addEventListener('load', sync);
    strip.querySelectorAll('img').forEach((i) => i.addEventListener('load', sync));
    new ResizeObserver(sync).observe(strip);
    sync();
  }
</script>
<style>
  .vid h2, .gal h2 { font-size: clamp(2rem, 4.4vw, 3.2rem); }
  .play { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; margin-top: 32px; border: 0; padding: 0; border-radius: 24px; overflow: hidden; cursor: pointer; background: #111 center / cover no-repeat; box-shadow: 0 24px 60px rgba(0,0,0,.2); }
  .play::before { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,.35); transition: background .3s; }
  .play:hover::before { background: rgba(0,0,0,.2); }
  .tri { position: absolute; left: 50%; top: 50%; width: 84px; height: 84px; margin: -42px 0 0 -42px; border-radius: 50%; background: var(--red); box-shadow: 0 10px 30px rgba(0,0,0,.4); transition: transform .25s; }
  .tri::after { content: ''; position: absolute; left: 34px; top: 25px; border-left: 24px solid #fff; border-top: 17px solid transparent; border-bottom: 17px solid transparent; }
  .play:hover .tri { transform: scale(1.08); }
  :global(.frame) { display: block; width: 100%; aspect-ratio: 16 / 9; margin-top: 32px; border: 0; border-radius: 24px; background: #000; }
  .gal { margin-top: clamp(56px, 8vw, 90px); }
  .gal__wrap { position: relative; }
  .gal__nav { position: absolute; top: calc(50% - 7px); transform: translateY(-50%); z-index: 2; width: 48px; height: 48px; border-radius: 50%; border: 0; background: #fff; color: var(--red); box-shadow: 0 6px 20px rgba(0,0,0,.28); cursor: pointer; display: grid; place-items: center; transition: background .2s, color .2s; }
  .gal__nav[hidden] { display: none; }
  .gal__nav svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .gal__nav:hover { background: var(--red); color: #fff; }
  .gal__nav--prev { left: 10px; } .gal__nav--next { right: 10px; }
  @media (max-width: 560px) { .gal__nav { width: 40px; height: 40px; } }
  .gal__grid { list-style: none; margin: 32px 0 0; padding: 0 0 14px; display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x proximity; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: var(--red) transparent; }
  .gal__grid li { flex: 0 0 auto; scroll-snap-align: start; }
  .gal__grid button { display: block; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 16px; overflow: hidden; }
  .gal__grid img { display: block; height: clamp(220px, 34vw, 380px); width: auto; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .gal__grid button:hover img { transform: scale(1.04); }
  .lb { border: 0; padding: 0; background: transparent; max-width: 96vw; max-height: 96vh; overflow: visible; }
  .lb::backdrop { background: rgba(0,0,0,.88); }
  .lb img { display: block; max-width: 96vw; max-height: 86vh; border-radius: 12px; }
  .lb__nav { position: fixed; top: 50%; transform: translateY(-50%); width: 52px; height: 52px; border-radius: 50%; border: 0; background: rgba(255,255,255,.92); color: var(--red); cursor: pointer; display: grid; place-items: center; box-shadow: 0 6px 20px rgba(0,0,0,.4); transition: background .2s, color .2s; }
  .lb__nav svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .lb__nav:hover { background: var(--red); color: #fff; }
  .lb__nav--prev { left: 14px; } .lb__nav--next { right: 14px; }
  @media (max-width: 560px) { .lb__nav { width: 42px; height: 42px; top: auto; bottom: 22px; transform: none; } .lb__nav--prev { left: calc(50% - 96px); } .lb__nav--next { right: calc(50% - 96px); } }
  .lb__n { position: fixed; left: 0; right: 0; bottom: 30px; margin: 0; text-align: center; color: #fff; font-family: var(--font-display); letter-spacing: .14em; font-size: .95rem; pointer-events: none; }
  @media (min-width: 561px) { .lb__n { bottom: 18px; } }
  .lb__x { position: absolute; right: 8px; top: 8px; width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(0,0,0,.55); color: #fff; font-size: 1.8rem; line-height: 1; cursor: pointer; }
  .reveal { opacity: 0; transform: translateY(32px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0ms); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
