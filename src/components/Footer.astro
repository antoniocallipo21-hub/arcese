---
import { getEntry } from 'astro:content';
const site = (await getEntry('settings', 'site'))!.data;
const links = [
  ['About', '/about/'], ['Stallions', '/stallions/'], ['Mares', '/mares/'], ['Lexi', '/lexi/'], ['Records', '/records/'],
  ['News', '/news/'], ['Media', '/media/'], ['Contact', '/contact/'],
];
---
<footer class="footer">
  <div class="container footer__in">
    <div>
      <a class="logo" href="/" aria-label={`${site.siteName} – home`}>
        {site.logo ? <img src={site.logo} alt={site.siteName} width="220" height="60" loading="lazy" /> : <span class="name">{site.siteName}</span>}
      </a>
      <p class="tag">{site.tagline}</p>
    </div>
    <div class="fcol">
      <nav class="fnav" aria-label="Footer">
        {links.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      {site.instagram && (
      <a class="ig" href={site.instagram} target="_blank" rel="noopener" aria-label="Arcese Quarter Horses on Instagram">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
        <span>@arceseqh</span>
      </a>
    )}
    </div>
  </div>
  <div class="container credits">
    <small>© {new Date().getFullYear()} {site.siteName}</small>
    <small class="made">Made by <a href="https://reiningfactory.com" target="_blank" rel="noopener">ReiningFactory</a></small>
    <small class="legal">
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/cookie-policy/">Cookie Policy</a>
    </small>
  </div>
</footer>
<style>
  .footer { background: var(--red); color: #fff; padding: 56px 0 24px; }
  .footer__in { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .name { font-family: var(--font-display); text-transform: uppercase; font-size: 1.8rem; color: #fff; margin: 0; letter-spacing: .04em; }
  .logo { display: inline-block; }
  .logo img { width: 220px; height: auto; filter: brightness(0) invert(1); }
  .tag { margin: 12px 0 0; padding-bottom: 8px; color: #fff; font-family: var(--font-script); font-size: clamp(1.4rem, 2.4vw, 1.75rem); line-height: 1.2; font-weight: 400; opacity: .95; }
  .fcol { display: grid; gap: 22px; align-content: start; }
  .ig { display: inline-flex; align-items: center; gap: 10px; justify-self: start; color: #fff; text-decoration: none; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .12em; font-weight: 600; opacity: .92; transition: opacity .2s; }
  .ig:hover { opacity: 1; text-decoration: underline; text-underline-offset: 5px; }
  .fnav { display: grid; grid-template-columns: repeat(2, auto); gap: 10px 40px; align-content: start; }
  .fnav a { color: #fff; text-decoration: none; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .12em; font-weight: 600; font-size: 1.05rem; opacity: .92; transition: opacity .2s; }
  .fnav a:hover { opacity: 1; text-decoration: underline; text-underline-offset: 5px; }
  @media (min-width: 760px) { .fnav { grid-template-columns: repeat(4, auto); gap: 14px 36px; } }
  .credits { margin-top: 36px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.35); color: rgba(255,255,255,.85); display: grid; gap: 10px; text-align: center; }
  .made a, .legal a { color: #fff; text-decoration: none; }
  .made a:hover, .legal a:hover { text-decoration: underline; }
  .legal { display: flex; gap: 18px; justify-content: center; }
  @media (min-width: 760px) {
    .credits { grid-template-columns: 1fr auto 1fr; align-items: center; text-align: left; }
    .made { text-align: center; }
    .legal { justify-content: flex-end; }
  }
</style>
