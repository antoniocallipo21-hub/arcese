---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { heroFor } from '../../lib/heroes';
const mares = (await getCollection('mares')).filter((m) => !m.data.standalone).sort((a, b) => a.data.order - b.data.order);
const hero = await heroFor('mares');
const rendered = await Promise.all(mares.map(async (m) => ({ m, Content: (await render(m)).Content })));
---
<Base title="Mares" image={hero}>
  <PageHero title="Mares" image={hero} />
  {rendered.map(({ m, Content }, i) => {
    const d = m.data;
    return (
      <section class:list={['strip', { flip: i % 2 === 1 }]} id={m.id} data-tone="light">
        <div class="strip__img">
          {d.photo ? <img src={d.photo} alt={d.name} loading={i === 0 ? 'eager' : 'lazy'} style={d.photoFocus ? `object-position:${d.photoFocus}` : undefined} /> : <div class="placeholder">{d.name}</div>}
        </div>
        <div class="strip__body">
          <div class="strip__in">
            {(d.damTitle ?? d.badge) && <p class="eyebrow reveal">{d.damTitle ?? d.badge}</p>}
            <h2 class="reveal">{d.name}</h2>
            {d.profile && <p class="prof reveal">{d.profile}</p>}
            {(d.sire || d.dam) && <p class="ped reveal">{[d.sire, d.dam].filter(Boolean).join(' × ')}</p>}
            <hr class="rule" />
            {d.facts.length > 0 && (
              <ul class="sfacts" style={`--n:${d.facts.length}`}>
                {d.facts.map((f) => <li class="reveal"><span class="fv">{f.value}</span><span class="fl">{f.label}</span></li>)}
              </ul>
            )}
            {m.body && <div class="prose reveal"><Content /></div>}
            {d.pedigreePdf && <p class="spdf reveal"><a class="link" href={d.pedigreePdf} target="_blank" rel="noopener">Black type pedigree (PDF) <i class="ar" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg></i></a></p>}
            {d.bestOffspring.length > 0 && (
              <div class="sbest reveal">
                <h3>Top offspring</h3>
                <ul>
                  {d.bestOffspring.map((o) => <li><span>{o.name}{o.sire && <em> by {o.sire}</em>}</span><b>{o.earnings}</b></li>)}
                </ul>
              </div>
            )}
          </div>
        </div>
      </section>
    );
  })}
</Base>
<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
<style>
  .strip { display: grid; grid-template-columns: minmax(0, 1fr); min-height: 100vh; min-height: 100svh; background: #fff; }
  .strip__img { position: relative; min-height: 62svh; background: #111; overflow: hidden; }
  .strip__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .strip__img .placeholder { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; background: radial-gradient(120% 90% at 85% 0%, #2a0a10 0%, #111 60%); color: rgba(255,255,255,.88); font-family: var(--font-display); text-transform: uppercase; letter-spacing: .08em; font-weight: 700; font-size: clamp(1.8rem, 3.4vw, 3rem); }
  .strip__body { display: flex; align-items: center; padding: clamp(40px, 8vw, 88px) var(--gutter); }
  .strip__in { width: 100%; max-width: 560px; margin: 0 auto; }
  .strip h2 { font-size: clamp(2.1rem, 3.7vw, 3.7rem); margin: 0 0 .1em; overflow-wrap: anywhere; }
  .prof { margin: 4px 0 2px; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .14em; font-weight: 600; color: var(--red); }
  .spdf { margin: 26px 0 0; }
  .link { color: var(--red); font-weight: 600; text-decoration: none; }
  .link:hover { text-decoration: underline; }
  .ar svg { width: 1em; height: 1em; vertical-align: -.12em; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .ped { margin: 0 0 14px; color: var(--muted); font-family: var(--font-display); text-transform: uppercase; letter-spacing: .1em; font-weight: 600; }
  .sfacts { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 16px 20px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .sfacts li { border-top: 3px solid var(--red); padding-top: 12px; }
  .fv { display: block; font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.7rem, 3vw, 2.3rem); line-height: 1; color: var(--black); }
  .fl { display: block; margin-top: 6px; color: var(--muted); font-size: .9rem; line-height: 1.3; }
  .prose { margin-top: 26px; }
  .prose :global(p) { font-size: 1.08rem; margin: 0 0 .8em; }
  .sbest { margin-top: 28px; }
  .sbest h3 { margin: 0 0 8px; font-size: 1.4rem; color: var(--red); }
  .sbest ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); column-gap: 28px; }
  .sbest li { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--line); }
  .sbest li span { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .04em; font-weight: 600; }
  .sbest em { font-family: var(--font-body); font-style: normal; text-transform: none; letter-spacing: 0; font-weight: 400; color: var(--muted); font-size: .9em; }
  .sbest b { color: var(--red); white-space: nowrap; }
  @media (min-width: 860px) {
    .strip { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .strip__img { min-height: 0; }
    .strip.flip .strip__img { order: 2; }
    .strip__in { margin: 0; }
    .strip:not(.flip) .strip__in { margin-right: auto; padding-left: clamp(0px, 3vw, 48px); }
    .strip.flip .strip__in { margin-left: auto; }
  }
  .reveal { opacity: 0; transform: translateY(32px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0ms); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
