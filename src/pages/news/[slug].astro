---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { heroFor } from '../../lib/heroes';

export async function getStaticPaths() {
  const all = await getCollection('news');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const hero = entry.data.image ?? (await heroFor('news'));
const date = entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={entry.data.title} description={entry.data.summary} image={entry.data.image}>
  <PageHero eyebrow={date} title={entry.data.title} image={hero} imagePosition={entry.data.imagePosition} />
  <section class="section">
    <div class="container">
      {date && <p class="meta">{date}</p>}
      <div class="prose"><Content /></div>
      <p class="back"><a href="/news/">← All news</a></p>
    </div>
  </section>
</Base>
<style>
  .prose :global(img) { display: block; max-width: min(100%, 440px); border-radius: 20px; margin: 28px 0; box-shadow: 0 16px 40px rgba(0,0,0,.12); }
  .prose :global(h3) { margin-top: 1.6em; color: var(--red); }
  .prose :global(p) { font-size: 1.08rem; }
  .meta { margin: 0 0 20px; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .18em; font-weight: 600; color: var(--red); }
  .back { margin-top: 48px; }
</style>
