---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { heroFor } from '../../lib/heroes';
const stallions = (await getCollection('stallions')).sort((a, b) => a.data.order - b.data.order);
const hero = await heroFor('stallions');
---
<Base title="Stallions" image={hero}>
  <PageHero eyebrow="Arcese Quarter Horses" title="Stallions" intro="Proven sires of reining, cutting and cow horses." image={hero} imageMobile="/images/stallions/hero-mobile.jpg" />
  <section class="section">
    <div class="container grid grid--3 list">
      {stallions.map((s, i) => (
        <a class="item reveal" style={`--d:${i * 120}ms`} href={`/stallions/${s.id}/`}>
          <div class="item__img">
            {s.data.cardPhoto || s.data.graphic || s.data.photo
              ? <img src={s.data.cardPhoto ?? s.data.graphic ?? s.data.photo} alt={s.data.name} loading="lazy" style={s.data.cardFocus ? `object-position:${s.data.cardFocus}` : undefined} />
              : <div class="placeholder">{s.data.name}</div>}
          </div>
          <div class="item__body">
            {s.data.badge && <p class="eyebrow">{s.data.badge}</p>}
            <h2>{s.data.name}</h2>
            {s.data.cardPedigree && <p class="ped">{s.data.cardPedigree}</p>}
            <span class="more">Discover more <i aria-hidden="true">→</i></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
<style>
  .list { grid-template-columns: repeat(auto-fill, minmax(230px, 300px)); justify-content: center; gap: 36px 32px; }
  .item { text-decoration: none; color: inherit; display: block; }
  .item__img { aspect-ratio: 4 / 5; border-radius: 20px; overflow: hidden; background: var(--paper); box-shadow: 0 18px 44px rgba(0,0,0,.13); }
  .item__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(.2,.7,.2,1); }
  .item:hover .item__img img { transform: scale(1.04); }
  .item__body { padding: 20px 4px 0; }
  .item__body h2 { font-size: 1.6rem; margin: 0 0 .15em; }
  .ped { margin: 0 0 .6em; font-size: .9rem; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; font-family: var(--font-display); }
  .more { font-family: var(--font-display); text-transform: uppercase; letter-spacing: .12em; font-weight: 700; color: var(--red); }
  .more i { font-style: normal; display: inline-block; transition: transform .25s; }
  .item:hover .more i { transform: translateX(6px); }
  .reveal { opacity: 0; transform: translateY(32px); transition: opacity .9s cubic-bezier(.2,.7,.2,1), transform .9s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0ms); }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
